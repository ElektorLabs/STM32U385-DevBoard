# Elektor STM32U385 Dev Board (260660): let normal users flash and use the serial port.
# Install: sudo cp 99-elektor-u385.rules /etc/udev/rules.d/ && sudo udevadm control --reload && sudo udevadm trigger
# STM32 ROM DFU bootloader
SUBSYSTEM=="usb", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="df11", MODE="0666", TAG+="uaccess"
# STM32duino USB CDC (the sketch's Serial port)
SUBSYSTEM=="tty", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="5740", MODE="0666", TAG+="uaccess"
